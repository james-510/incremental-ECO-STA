execute_process(COMMAND "${PROGRAM}" "${SAMPLE}"
  RESULT_VARIABLE status OUTPUT_VARIABLE actual ERROR_VARIABLE diagnostic)
if(SAMPLE STREQUAL "cycle")
  if(NOT status EQUAL 1 OR NOT diagnostic MATCHES "combinational cycle detected")
    message(FATAL_ERROR "Expected cycle rejection; status=${status}: ${diagnostic}")
  endif()
else()
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "${SAMPLE} failed: ${diagnostic}")
  endif()
  file(READ "${EXPECTED}" expected)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "${SAMPLE} differs from ${EXPECTED}\nActual:\n${actual}")
  endif()
endif()
